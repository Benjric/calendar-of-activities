# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and documents what must be set.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated by `prisma generate` on every install, so it is never committed.
/src/generated/prisma

# Local AI-assistant tooling. Machine-specific caches, not part of the product.
/.agents
/.claude
/.cursor
/.impeccable
/.windsurf
/skills-lock.json

# Appended by `vercel link`. Both are already covered above; the re-listed
# `.env*` is kept last-match-wins safe by repeating the template exception,
# otherwise it would silently re-ignore .env.example.
.vercel
.env*
!.env.example
