# --- Database -------------------------------------------------------------
# Local development points at your local PostgreSQL 18 instance.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/calendar_of_activities?schema=public"

# On Vercel this is replaced with the hosted Postgres connection string
# (Neon/Supabase). Vercel cannot reach your local machine, so the local URL
# above is never valid in production.

# --- Auth.js --------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- Vercel Blob (MOV / completion report uploads) -------------------------
# Serverless has no writable disk; uploads go to Blob storage.
BLOB_READ_WRITE_TOKEN=""
