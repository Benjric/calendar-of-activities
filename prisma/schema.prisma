// Calendar of Activities — data model
//
// Scheduling is DATE-ONLY and may span multiple days. Every conflict check
// (date / venue / participant) is therefore a day-granularity range overlap:
//   (a.startDate <= b.endDate) AND (a.endDate >= b.startDate)
//
// Variance is NEVER stored. It is derived on read as:
//   result = accomplishment - target
//   result > 0 -> Gain  (reveals Notable Practice)
//   result < 0 -> Gap   (reveals Justification)
//   result = 0 -> Met   (reveals neither)
// Physical and financial variance are computed independently and each has its
// own narrative pair, so one activity can show a Gain box and a Gap box at once.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ActivityStatus {
  PLANNED // booked via the wizard, not yet acted on
  CONDUCTED // completed; unlocks target vs. accomplishment reporting
  RESCHEDULED // postponed; unlocks the catch-up plan
  DROPPED // cancelled; archived out of the active calendar
}

enum ActivityType {
  LND // Learning & Development
  NON_LND
}

enum SourceOfFund {
  MOOE
  HRTD
  PSF
  OTHER
}

/// Who can do what.
///
/// Only PROGRAM_MANAGER and ADMIN may create or change activities. Everyone
/// else reads the Calendar and the Catch-up Plan and nothing more — the
/// Register, Conflicts and Archive views are not theirs to see.
enum UserRole {
  ADMIN // program manager powers, plus account and lookup management
  PROGRAM_MANAGER // books activities and updates their status
  VIEWER // read-only: Calendar and Catch-up Plan only
}

// Which of the three booking-phase checks was overridden.
enum ConflictKind {
  DATE // Step 2 — another activity already occupies these dates
  VENUE // Step 3 — the venue is already booked for these dates
  PARTICIPANT // Step 4 — one or more participants are already committed
}

enum AttachmentKind {
  COMPLETION_REPORT
  MOV // Means of Verification
  OTHER
}

// ---------------------------------------------------------------------------
// Lookups
// ---------------------------------------------------------------------------

model Division {
  id        String   @id @default(cuid())
  name      String   @unique
  acronym   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activitiesLed Activity[] @relation("LeadDivision")
  people        Person[]
  users         User[]

  @@map("divisions")
}

model Program {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities Activity[]

  @@map("programs")
}

model Venue {
  id       String  @id @default(cuid())
  name     String  @unique
  location String?
  capacity Int?
  // Training halls are bookable and conflict-checked; non-bookable venues
  // (e.g. "Online / MS Teams") skip the Step 3 availability check entirely.
  isBookable Boolean @default(true)
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities Activity[]

  @@map("venues")
}

/// An employee. Serves as both focal person and participant. Not every Person
/// has a login, so this is deliberately separate from User.
model Person {
  id         String  @id @default(cuid())
  fullName   String
  position   String?
  email      String? @unique
  divisionId String?
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  division           Division?            @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  focalForActivities Activity[]           @relation("FocalPerson")
  participations     ActivityParticipant[]
  user               User?

  @@index([divisionId])
  @@index([fullName])
  @@map("people")
}

// ---------------------------------------------------------------------------
// Core
// ---------------------------------------------------------------------------

model Activity {
  id String @id @default(cuid())

  // --- Step 1: Core details ---
  title     String
  programId String?

  // --- Step 2: Schedule (date-only, inclusive range) ---
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  // --- Steps 3 & 5: Admin details ---
  venueId        String?
  leadDivisionId String?
  focalPersonId  String?

  // --- Step 6: Financials & classification ---
  type                 ActivityType
  performanceIndicator String?
  hasFinancialReq      Boolean       @default(false)
  sourceOfFund         SourceOfFund?
  sourceOfFundOther    String? // free text when sourceOfFund = OTHER

  // --- Lifecycle ---
  status ActivityStatus @default(PLANNED)

  // --- CONDUCTED: targets vs. accomplishments -----------------------------
  // Variance is derived, never persisted. See header note.
  physicalTarget         Decimal? @db.Decimal(14, 2)
  physicalAccomplishment Decimal? @db.Decimal(14, 2)
  financialTarget        Decimal? @db.Decimal(14, 2)
  financialAccomplishment Decimal? @db.Decimal(14, 2)

  // Four narrative fields: each variance dimension gets its own pair, and the
  // sign of that dimension's result decides which one the form reveals.
  physicalNotablePractice String? // shown when physical result > 0
  physicalJustification   String? // shown when physical result < 0
  financialNotablePractice String? // shown when financial result > 0
  financialJustification   String? // shown when financial result < 0

  conductedAt DateTime?

  // --- DROPPED ------------------------------------------------------------
  reasonForDropping String?
  // Soft delete. The active calendar filters on archivedAt: null; dropped
  // activities stay queryable in the archive view rather than being removed.
  archivedAt DateTime?

  // --- Audit --------------------------------------------------------------
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  program      Program?  @relation(fields: [programId], references: [id], onDelete: SetNull)
  venue        Venue?    @relation(fields: [venueId], references: [id], onDelete: SetNull)
  leadDivision Division? @relation("LeadDivision", fields: [leadDivisionId], references: [id], onDelete: SetNull)
  focalPerson  Person?   @relation("FocalPerson", fields: [focalPersonId], references: [id], onDelete: SetNull)
  createdBy    User?     @relation("ActivityCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  participants      ActivityParticipant[]
  attachments       Attachment[]
  conflictOverrides ConflictOverride[]
  statusHistory     StatusHistory[]
  reschedules       RescheduleRecord[]

  // Range-overlap conflict queries always filter on these two columns first.
  @@index([startDate, endDate])
  @@index([venueId, startDate, endDate])
  @@index([status])
  @@index([archivedAt])
  @@map("activities")
}

model ActivityParticipant {
  id         String @id @default(cuid())
  activityId String
  personId   String

  createdAt DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([activityId, personId])
  @@index([personId])
  @@map("activity_participants")
}

// ---------------------------------------------------------------------------
// Accountability
// ---------------------------------------------------------------------------

/// Records every time a user chose "Continue anyway" past a booking-phase
/// conflict. The spec lets all three checks be overridden; without this row the
/// decision is made and then forgotten, so there is no way to answer "who
/// approved this double-booking?" months later.
model ConflictOverride {
  id         String       @id @default(cuid())
  activityId String
  kind       ConflictKind

  /// Human-readable snapshot of what it collided with, captured at decision
  /// time so the record survives later edits to the conflicting activity.
  details String

  /// IDs of the activities this one collided with, for forensic lookup.
  conflictingActivityIds String[]

  overriddenById String?
  overriddenAt   DateTime @default(now())

  activity     Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  overriddenBy User?    @relation(fields: [overriddenById], references: [id], onDelete: SetNull)

  @@index([activityId])
  @@index([kind])
  @@map("conflict_overrides")
}

/// Append-only trail of every status transition.
model StatusHistory {
  id         String          @id @default(cuid())
  activityId String
  fromStatus ActivityStatus?
  toStatus   ActivityStatus
  note       String?

  changedById String?
  changedAt   DateTime @default(now())

  activity  Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  changedBy User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([activityId, changedAt])
  @@map("status_history")
}

/// One row per postponement. An activity can slip more than once, and the
/// accumulated rows ARE the catch-up plan — which is why this is a table and
/// not a pair of columns on Activity.
model RescheduleRecord {
  id         String @id @default(cuid())
  activityId String

  reasonForPostponement String

  // The schedule being vacated.
  previousStartDate DateTime @db.Date
  previousEndDate   DateTime @db.Date

  // The newly proposed schedule, re-run through the Step 2 date conflict check.
  proposedStartDate DateTime @db.Date
  proposedEndDate   DateTime @db.Date

  createdById String?
  createdAt   DateTime @default(now())

  activity  Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([activityId])
  @@map("reschedule_records")
}

model Attachment {
  id         String         @id @default(cuid())
  activityId String
  kind       AttachmentKind @default(MOV)

  fileName String
  /// Vercel Blob URL. Serverless has no writable disk, so uploads never touch
  /// the local filesystem.
  url      String
  mimeType String?
  sizeBytes Int?

  uploadedById String?
  uploadedAt   DateTime @default(now())

  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  uploadedBy User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([activityId])
  @@map("attachments")
}

// ---------------------------------------------------------------------------
// Auth (Auth.js / @auth/prisma-adapter)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  /// Defaults to the least privilege. A new account can read the calendar and
  /// nothing else until someone deliberately raises it.
  role UserRole @default(VIEWER)

  /// bcrypt hash. Null for an account that signs in through a provider rather
  /// than a password.
  passwordHash String?

  divisionId String?
  /// Optional link to the employee record, so a focal person and their login
  /// are the same human.
  personId String? @unique
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  division Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  person   Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)

  accounts          Account[]
  sessions          Session[]
  activitiesCreated Activity[]         @relation("ActivityCreatedBy")
  conflictOverrides ConflictOverride[]
  statusChanges     StatusHistory[]
  reschedules       RescheduleRecord[]
  attachments       Attachment[]

  @@index([divisionId])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
